module

public import Mathlib

@[expose] public section

/-!
# Selected formal results from the order-seven stable-marriage companion

The rank-permutation definition below is the ordinary strict, complete
stable-marriage model. The actual-profile result is the unconditional lower
bound `85 ≤ f 7`. The finite event order is generated by successive
participation in the displayed twenty-swap word and has exactly 85 ideals.

The remaining assertions concern finite posets with the four explicit
forbidden induced patterns, fixed-token runs with strictly worsening
participants, or graph simulations with explicit completeness hypotheses.
They support the upper-bound argument but do not assemble a universal
actual-profile upper bound in Lean. In particular, no unconditional Lean
theorem `f 7 = 85` is advertised.

All mathematical definitions have their complete values here. Only theorem
proofs contain deliberate holes. This statement module imports Mathlib alone;
it imports none of the submitted proof development.
-/

noncomputable section
open scoped BigOperators

namespace F7Manuscript

abbrev Agent (n : ℕ) := Fin n

abbrev Matching (n : ℕ) := Equiv.Perm (Agent n)

structure Profile (n : ℕ) where
  maleRank : Agent n → Equiv.Perm (Agent n)
  femaleRank : Agent n → Equiv.Perm (Agent n)
  deriving Fintype

def BlockingPair {n : ℕ} (I : Profile n) (μ : Matching n)
    (m w : Agent n) : Prop :=
  I.maleRank m w < I.maleRank m (μ m) ∧
  I.femaleRank w m < I.femaleRank w (μ.symm w)

def Stable {n : ℕ} (I : Profile n) (μ : Matching n) : Prop :=
  ∀ m w, ¬ BlockingPair I μ m w

noncomputable def stableCount {n : ℕ} (I : Profile n) : ℕ := by
  classical
  exact Fintype.card {μ : Matching n // Stable I μ}

noncomputable def f (n : ℕ) : ℕ := by
  classical
  exact (Finset.univ : Finset (Profile n)).sup stableCount

end F7Manuscript

namespace F7Manuscript.Lower85

def maleRankTable : Fin 7 → Fin 7 → Fin 7 := ![
  ![0, 1, 5, 6, 3, 4, 2],
  ![1, 0, 3, 2, 5, 4, 6],
  ![2, 3, 0, 1, 5, 6, 4],
  ![4, 3, 1, 0, 5, 2, 6],
  ![6, 5, 2, 3, 0, 1, 4],
  ![4, 5, 6, 3, 1, 0, 2],
  ![4, 1, 6, 5, 3, 2, 0]]

def femaleRankTable : Fin 7 → Fin 7 → Fin 7 := ![
  ![6, 5, 4, 3, 0, 1, 2],
  ![5, 6, 2, 3, 1, 0, 4],
  ![1, 2, 5, 4, 3, 6, 0],
  ![0, 4, 5, 6, 3, 2, 1],
  ![4, 0, 1, 2, 6, 5, 3],
  ![2, 1, 0, 4, 5, 6, 3],
  ![4, 6, 1, 0, 2, 3, 5]]

/-- Every row of this fixed rank table is a permutation. -/
theorem maleRankTable_bijective : ∀ m, Function.Bijective (maleRankTable m) := by
  sorry

/-- Every row of this fixed rank table is a permutation. -/
theorem femaleRankTable_bijective : ∀ w, Function.Bijective (femaleRankTable w) := by
  sorry

noncomputable def profile : Profile 7 where
  maleRank m := Equiv.ofBijective (maleRankTable m) (maleRankTable_bijective m)
  femaleRank w := Equiv.ofBijective (femaleRankTable w) (femaleRankTable_bijective w)

/-- The displayed strict complete profile has at least 85 stable perfect matchings. -/
theorem profile_has_at_least_85 : 85 ≤ stableCount profile := by
  sorry

/-- There exists a strict complete seven-by-seven profile with at least 85 stable matchings. -/
theorem exists_profile_with_at_least_85 :
    ∃ I : Profile 7, 85 ≤ stableCount I := by
  sorry

/-- The maximum over all strict complete seven-by-seven profiles is at least 85. -/
theorem f7_at_least_85 : 85 ≤ f 7 := by
  sorry

end F7Manuscript.Lower85

namespace ConditionalUL
variable {V : Type*} [PartialOrder V]

def Inc (a b : V) : Prop := ¬ a ≤ b ∧ ¬ b ≤ a

def NoInduced311 : Prop :=
  ∀ a b c p q : V, a < b → b < c → Inc p q →
    Inc a p → Inc b p → Inc c p →
    Inc a q → Inc b q → Inc c q → False

def AntichainOn (S : Set V) : Prop :=
  ∀ ⦃a⦄, a ∈ S → ∀ ⦃b⦄, b ∈ S → a ≠ b → Inc a b

def NoInduced221 : Prop :=
  ∀ a b c d p : V, a < b → c < d →
    Inc a c → Inc a d → Inc b c → Inc b d →
    Inc p a → Inc p b → Inc p c → Inc p d → False

def NoInduced33 : Prop :=
  ∀ a b c d e f : V, a < b → b < c → d < e → e < f →
    Inc a d → Inc a e → Inc a f →
    Inc b d → Inc b e → Inc b f →
    Inc c d → Inc c e → Inc c f → False

def NoFourAntichain : Prop :=
  ∀ a b c d : V, Inc a b → Inc a c → Inc a d →
    Inc b c → Inc b d → Inc c d → False

end ConditionalUL

namespace NeutralCore
open ConditionalUL
variable {V : Type*} [Fintype V] [PartialOrder V] [DecidableEq V] [DecidableLE V]
instance inc_decidable (x y : V) : Decidable (Inc x y) := by
  unfold Inc; infer_instance
instance anti_decidable (T : Finset V) : Decidable (AntichainOn (T : Set V)) := by
  unfold AntichainOn; infer_instance

def pairs (P : Finset V) : Finset (V × V) :=
  (P.product P).filter (fun p => Inc p.1 p.2)

def A2 : ℕ := (pairs (Finset.univ : Finset V)).card / 2

def triples (P : Finset V) : Finset (Finset V) :=
  P.powerset.filter (fun T => T.card=3 ∧ AntichainOn (T : Set V))

def A3 : ℕ := (triples (Finset.univ : Finset V)).card

def a : ℤ := 3*(Fintype.card V : ℤ)-8-(A2 (V := V) : ℤ)

def D : ℤ := (Fintype.card V : ℤ)-2-(A3 (V := V) : ℤ)-a (V := V)

def PairClass : Prop := NoFourAntichain (V := V) ∧ NoInduced311 (V := V) ∧
  NoInduced221 (V := V) ∧ NoInduced33 (V := V)

def aOn (P : Finset V) : ℤ := 3*(P.card : ℤ)-8-(((pairs P).card/2 : ℕ) : ℤ)

def DOn (P : Finset V) : ℤ := (P.card : ℤ)-2-((triples P).card : ℤ)-aOn P

def BadOn (P : Finset V) : Prop := 5≤P.card ∧ 0≤aOn P ∧ aOn P≤2 ∧ 0<DOn P

def delta3On (P : Finset V) : ℤ := (P.card : ℤ)-2-((triples P).card : ℤ)

def delta3 : ℤ := (Fintype.card V : ℤ)-2-(A3 (V:=V) : ℤ)

/-- Every induced subset of at least five points in PairClass has at most 3r-8 incomparable unordered pairs. -/
theorem pairClass_unordered_pair_bound (hClass : PairClass (V := V))
    (Q : Finset V) (hQ : 5≤Q.card) :
    (((pairs Q).card/2 : ℕ) : ℤ)≤3*(Q.card : ℤ)-8 := by
  sorry

/-- The pair deficit a is nonnegative in PairClass at size at least five. -/
theorem pairClass_deficit_nonnegative (hClass : PairClass (V := V))
    (hn : 5≤Fintype.card V) : 0≤a (V := V) := by
  sorry

/-- A subset with nonnegative pair deficit at most two and positive difference deficit has at most nine points. -/
theorem general_bad_card_le_nine (hClass : PairClass (V:=V)) (P : Finset V)
    (hP : BadOn P) : P.card≤9 := by
  sorry

/-- At size at least ten and pair deficit between zero and two, the triple deficit is at most the pair deficit. -/
theorem pairClass_deficit_transfer (hClass : PairClass (V:=V))
    (hn : 10≤Fintype.card V) (ha0 : 0≤a (V:=V)) (ha2 : a (V:=V)≤2) :
    delta3 (V:=V)≤a (V:=V) := by
  sorry

/-- At size at least five in PairClass, the difference delta3-a is at most two. -/
theorem universal_difference_le_two_univ (hClass : PairClass (V:=V))
    (hn : 5≤Fintype.card V) : D (V:=V)≤2 := by
  sorry

namespace IdealCounting

noncomputable def antichainSets : Finset (Finset V) :=
  Finset.univ.filter (fun S => AntichainOn (S : Set V))

noncomputable def idealSets : Finset (Finset V) := by
  classical
  exact Finset.univ.filter (fun P => IsLowerSet (P : Set V))

/-- Every finite poset has equally many downward-closed sets and antichains, including the empty set. -/
theorem ideal_count_eq_antichain_count :
    (idealSets (V:=V)).card=(antichainSets (V:=V)).card := by
  sorry

/-- At width at most three, the ideal count is 1+r+A2+A3. -/
theorem ideal_count_width_three (hWidth : NoFourAntichain (V:=V)) :
    (idealSets (V:=V)).card=1+Fintype.card V+A2 (V:=V)+A3 (V:=V) := by
  sorry

end IdealCounting
end NeutralCore

namespace F7Manuscript
open NeutralCore ConditionalUL
variable {V : Type*} [Fintype V] [PartialOrder V] [DecidableEq V] [DecidableLE V]

def totalDeficit : ℤ := a (V := V) + delta3 (V := V)

/-- At width at most three, ideal count plus total deficit a+delta3 equals 5r-9. -/
theorem ideal_deficit_accounting (hWidth : NoFourAntichain (V := V)) :
    ((IdealCounting.idealSets (V := V)).card : ℤ) + totalDeficit (V := V) =
      5 * (Fintype.card V : ℤ) - 9 := by
  sorry

/-- A poset with at most four elements has at most sixteen ideals. -/
theorem small_poset_ideal_count_le_sixteen (hn : Fintype.card V ≤ 4) :
    (IdealCounting.idealSets (V := V)).card ≤ 16 := by
  sorry

/-- PairClass posets of size five to eighteen have at most 81 ideals when delta3 is nonnegative. -/
theorem five_to_eighteen_ideal_count_le_eighty_one
    (hClass : PairClass (V := V)) (h5 : 5 ≤ Fintype.card V)
    (h18 : Fintype.card V ≤ 18) (hDelta : 0 ≤ delta3 (V := V)) :
    (IdealCounting.idealSets (V := V)).card ≤ 81 := by
  sorry

/-- A size-twenty PairClass poset has at most 85 ideals when delta3 is at least three. -/
theorem r20_high_triple_ideal_count_le_85
    (hClass : PairClass (V := V)) (hn : Fintype.card V = 20)
    (hDelta : 3 ≤ delta3 (V := V)) :
    (IdealCounting.idealSets (V := V)).card ≤ 85 := by
  sorry

/-- A size-twenty-one PairClass poset has at most 84 ideals when delta3 is at least seven. -/
theorem r21_high_triple_ideal_count_le_84
    (hClass : PairClass (V := V)) (hn : Fintype.card V = 21)
    (hDelta : 7 ≤ delta3 (V := V)) :
    (IdealCounting.idealSets (V := V)).card ≤ 84 := by
  sorry

/-- At size twenty-one and delta3=6, the bound 85 requires the displayed equality-exclusion premise. -/
theorem r21_delta_six_ideal_count_le_85_of_equality_exclusion
    (hClass : PairClass (V := V)) (hn : Fintype.card V = 21)
    (hDelta : delta3 (V := V) = 6)
    (exclude : D (V := V) = 2 → A3 (V := V) = 0) :
    (IdealCounting.idealSets (V := V)).card ≤ 85 := by
  sorry

end F7Manuscript

namespace F7Manuscript.Construction
open ConditionalUL NeutralCore

structure Event where
  index : Fin 20
  deriving Fintype, DecidableEq

def group : Fin 20 → Fin 3 := ![0, 1, 2, 1, 0, 2, 1, 2, 0, 2, 1, 0, 2, 1, 0, 2, 0, 1, 2, 0]
def position : Fin 20 → ℕ := ![1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6, 7, 7]
def predecessorVector : Fin 20 → Fin 3 → ℕ := ![
  ![1, 0, 0],
  ![0, 1, 0],
  ![0, 0, 1],
  ![0, 2, 0],
  ![2, 1, 0],
  ![1, 0, 2],
  ![0, 3, 1],
  ![1, 2, 3],
  ![3, 1, 2],
  ![2, 2, 4],
  ![1, 4, 3],
  ![4, 3, 2],
  ![2, 4, 5],
  ![3, 5, 3],
  ![5, 3, 4],
  ![4, 4, 6],
  ![6, 4, 5],
  ![4, 6, 6],
  ![5, 4, 7],
  ![7, 5, 5]]
def parents : Fin 20 → Finset (Fin 20) := ![
  {},
  {},
  {},
  {1},
  {0, 1},
  {0, 2},
  {2, 3},
  {3, 5},
  {4, 5},
  {4, 7},
  {6, 7},
  {6, 8},
  {9, 10},
  {8, 10},
  {9, 11},
  {11, 12},
  {12, 14},
  {13, 15},
  {14, 15},
  {13, 16}]
def word : Fin 20 → Fin 7 × Fin 7 := ![
  (2, 3),
  (0, 1),
  (4, 5),
  (0, 6),
  (1, 2),
  (3, 4),
  (0, 5),
  (3, 6),
  (1, 4),
  (2, 3),
  (0, 6),
  (4, 5),
  (3, 6),
  (0, 1),
  (2, 4),
  (5, 6),
  (2, 3),
  (0, 6),
  (4, 5),
  (1, 2)]

def tableLE (i j : Fin 20) : Prop := position i ≤ predecessorVector j (group i)

instance tableLE_decidable (i j : Fin 20) : Decidable (tableLE i j) :=
  inferInstanceAs (Decidable (position i ≤ predecessorVector j (group i)))


/-- The displayed predecessor-vector relation satisfies the corresponding partial-order law. -/
theorem table_refl : ∀ i, tableLE i i := by
  sorry

/-- The displayed predecessor-vector relation satisfies the corresponding partial-order law. -/
theorem table_trans : ∀ i j k, tableLE i j → tableLE j k → tableLE i k := by
  sorry

/-- The displayed predecessor-vector relation satisfies the corresponding partial-order law. -/
theorem table_antisymm : ∀ i j, tableLE i j → tableLE j i → i = j := by
  sorry

instance : PartialOrder Event where
  le i j := tableLE i.index j.index
  le_refl i := table_refl i.index
  le_trans i j k := table_trans i.index j.index k.index
  le_antisymm i j hij hji := by
    cases i; cases j
    congr 1
    exact table_antisymm _ _ hij hji

instance : DecidableLE Event := fun i j => tableLE_decidable i.index j.index

def Adj (i j : Event) : Prop := i.index ∈ parents j.index
instance (i j : Event) : Decidable (Adj i j) :=
  inferInstanceAs (Decidable (i.index ∈ parents j.index))

def Participates (i : Fin 20) (m : Fin 7) : Prop :=
  m = (word i).1 ∨ m = (word i).2

instance (i : Fin 20) (m : Fin 7) : Decidable (Participates i m) :=
  inferInstanceAs (Decidable (m = (word i).1 ∨ m = (word i).2))

def SuccessiveParticipation (i j : Fin 20) : Prop :=
  i.val < j.val ∧ ∃ m : Fin 7, Participates i m ∧ Participates j m ∧
    ∀ k : Fin 20, i.val < k.val → k.val < j.val → ¬ Participates k m

instance (i j : Fin 20) : Decidable (SuccessiveParticipation i j) := by
  unfold SuccessiveParticipation
  infer_instance


/-- The displayed direct parents are exactly the consecutive participations of a shared site. -/
theorem parents_are_successive_participations :
    ∀ i j : Fin 20, i ∈ parents j ↔ SuccessiveParticipation i j := by
  sorry

/-- The predecessor-vector order equals the reflexive transitive closure of those direct participation edges. -/
theorem order_is_generated_by_participations (i j : Event) :
    i ≤ j ↔ Relation.ReflTransGen Adj i j := by
  sorry

/-- The displayed event poset has width at most three. -/
theorem width_three : NoFourAntichain (V := Event) := by
  sorry

/-- The event poset has twenty elements. -/
theorem event_card : Fintype.card Event = 20 := by
  sorry

/-- The event poset has 46 incomparable unordered pairs. -/
theorem pair_count : A2 (V := Event) = 46 := by
  sorry

/-- The event poset has eighteen size-three antichains. -/
theorem triple_count : A3 (V := Event) = 18 := by
  sorry

/-- The displayed event poset has exactly 85 downward-closed subsets. -/
theorem event_poset_has_85_ideals :
    (IdealCounting.idealSets (V := Event)).card = 85 := by
  sorry

end F7Manuscript.Construction

namespace F6SmallBlockTokenCapacity

structure TokenRun (B W : Type*) [Fintype B] [Fintype W] (q : ℕ) where
  support : Fin q → Finset B
  state : Fin (q + 1) → (B ≃ W)
  rank : B → W → ℕ
  HMIN : ∀ i, 2 ≤ (support i).card
  HOUT : ∀ i b, b ∉ support i → state i.castSucc b = state i.succ b
  HWORSE : ∀ i b, b ∈ support i →
    rank b (state i.castSucc b) < rank b (state i.succ b)

namespace TokenRun
variable {B W : Type*} [Fintype B] [Fintype W] {q : ℕ}
variable (R : TokenRun B W q)

noncomputable def participationSteps (b : B) : Finset (Fin q) := by
  classical
  exact Finset.univ.filter (fun i => b ∈ R.support i)

/-- A fixed-token run on at most two sites has at most one step. -/
theorem TWO_SITE_CAPACITY (R : TokenRun B W q) (hB : Fintype.card B ≤ 2) : q ≤ 1 := by
  sorry

/-- A fixed-token run on at most three sites has at most two steps. -/
theorem THREE_SITE_CAPACITY (R : TokenRun B W q) (hB : Fintype.card B ≤ 3) :
    q ≤ 2 := by
  sorry

end TokenRun
end F6SmallBlockTokenCapacity

namespace F7Manuscript
open F6SmallBlockTokenCapacity
variable {B W : Type*} [Fintype B] [Fintype W] {q : ℕ}

/-- A fixed-token run on at most seven sites has at most 21 steps. -/
theorem seven_site_length (R : TokenRun B W q) (hB : Fintype.card B ≤ 7) :
    q ≤ 21 := by
  sorry

/-- A 21-step run on seven sites uses exactly two sites in every support. -/
theorem saturated_supports_are_binary (R : TokenRun B W 21)
    (hB : Fintype.card B = 7) : ∀ i, (R.support i).card = 2 := by
  sorry

/-- In that saturated run every site participates six times. -/
theorem saturated_participation_is_six (R : TokenRun B W 21)
    (hB : Fintype.card B = 7) : ∀ b, (R.participationSteps b).card = 6 := by
  sorry

/-- Total incidence equals two per step plus the support-size surpluses. -/
theorem incidence_surplus_identity (R : TokenRun B W q) :
    (∑ i : Fin q, (R.support i).card) =
      2 * q + ∑ i : Fin q, ((R.support i).card - 2) := by
  sorry

end F7Manuscript

namespace F7ProofInterfaces
universe u v

inductive Steps {S : Type u} (step : S → S → Prop) : Nat → S → S → Prop where
  | nil (s : S) : Steps step 0 s s
  | cons {n : Nat} {s t z : S} :
      step s t → Steps step n t z → Steps step (n + 1) s z

end F7ProofInterfaces

namespace F7Manuscript
open F7ProofInterfaces

/-- A budget dropping by at least one on each edge bounds the path length plus the final budget. -/
theorem decreasing_budget_path_bound {S : Type*} {step : S → S → Prop}
    (β : S → ℕ) (decrease : ∀ s t, step s t → 1 + β t ≤ β s)
    {n : ℕ} {s t : S} (path : Steps step n s t) : n + β t ≤ β s := by
  sorry

/-- A graph budget bounds the original path when each original step has a graph successor with the same semantic state. -/
theorem simulated_graph_budget_bound {S N : Type*}
    {step : S → S → Prop} {child : N → N → Prop}
    (sem : N → S) (β : N → ℕ)
    (decrease : ∀ p q, child p q → 1 + β q ≤ β p)
    (complete : ∀ p t, step (sem p) t → ∃ q, child p q ∧ sem q = t)
    {n : ℕ} {p : N} {t : S} (path : Steps step n (sem p) t) : n ≤ β p := by
  sorry

end F7Manuscript
