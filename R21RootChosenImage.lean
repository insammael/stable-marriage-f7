theorem chosen_image_valid (input : Input) (o : Output) (computed : runInput input=some o)
    (motif : eligible o=true) : ∃im, chosenImage (inputCode input)=some im ∧imageValid o im := by
  have check := checked_all input
  change (match runInput input with
    | none => true
    | some o => if eligible o then
      match chosenImage (inputCode input) with
      | none => false
      | some im => decide (imageValid o im)
      else true)=true at check
  simp only [computed,motif,↓reduceIte] at check
  cases chosen : chosenImage (inputCode input) with
  | none => simp [chosen] at check
  | some im => exact ⟨im,rfl,of_decide_eq_true (by simpa [chosen] using! check)⟩

#print axioms chosen_image_valid
