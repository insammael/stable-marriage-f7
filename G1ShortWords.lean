module

public import F7Manuscript.PeriodicPrefixData
public import F7Manuscript.PeriodicGraphActual

@[expose] public section

/-!
Canonical 13/14-center support words generated by the same deterministic
`modeState`/`retained` formula already used by `PeriodicPrefixData.modeWord`.
This file performs no search and proves no finite-table completeness claim.
It only gives a common object to the actual `ReturnCertificate.Realizes`
adapter and to the frozen `prefixFresh` relation.  Pair orientation is a
notation convention: `swapSite` and `Realizes` depend only on the unordered
two-site support.  In particular, some mode-B pairs are oppositely oriented
from the sorted pairs printed in the raw JSON, with identical semantics.
-/

namespace F7Manuscript.G1ShortWords

open F7Manuscript.PartnerGraph
open F7Manuscript.PartnerGraph.Periodic

abbrev Site := Fin 7
abbrev Swap := Site × Site
abbrev Rel := F7Manuscript.PartnerGraph.Rel

/-- The three pairwise-disjoint initial binary events. -/
def initialThree : List Swap :=
  [(0, 1), (2, 3), (4, 5)]

/-- Initial three events followed by `m` centers of one forced mode.
`b=true` is mode A and `b=false` is mode B, as in `rootOf`. -/
def modeWordN (b : Bool) (m : ℕ) : List Swap :=
  initialThree ++
    List.ofFn (fun i : Fin m =>
      (F7Periodic.retained (F7Periodic.modeState b i.val)
        (F7Periodic.color i.val) (F7Periodic.modeChoice b i.val),
       (F7Periodic.modeState b i.val).idle))

/-- The two word families needed by the short theorem. -/
def word13 (b : Bool) : List Swap := modeWordN b 13
def word14 (b : Bool) : List Swap := modeWordN b 14

def word13A : List Swap := word13 true
def word13B : List Swap := word13 false
def word14A : List Swap := word14 true
def word14B : List Swap := word14 false

theorem modeWordN_eleven (b : Bool) :
    modeWordN b 11 = F7Manuscript.PartnerGraph.Periodic.modeWord b := by
  rfl

@[simp] theorem modeWordN_length (b : Bool) (m : ℕ) :
    (modeWordN b m).length = 3 + m := by
  simp [modeWordN, initialThree] <;> omega

@[simp] theorem word13_length (b : Bool) : (word13 b).length = 16 := by
  simp [word13]

@[simp] theorem word14_length (b : Bool) : (word14 b).length = 17 := by
  simp [word14]

@[simp] theorem word13A_length : word13A.length = 16 := by simp [word13A]
@[simp] theorem word13B_length : word13B.length = 16 := by simp [word13B]
@[simp] theorem word14A_length : word14A.length = 17 := by simp [word14A]
@[simp] theorem word14B_length : word14B.length = 17 := by simp [word14B]

/-- Reversing the displayed orientation of a binary exchange does not change
its token permutation. -/
theorem swapSite_symm (a b m : Site) :
    ReturnCertificate.swapSite (b, a) m =
      ReturnCertificate.swapSite (a, b) m := by
  by_cases ha : m = a <;> by_cases hb : m = b <;>
    simp [ReturnCertificate.swapSite, ha, hb] <;>
    exact fun h => h.symm

/-- Fixed finite structural receipts.  They are reductions of the deterministic
word definitions, not a search or a graph-table check. -/
theorem word13_pairAt_first (b : Bool) (i : Fin 3) :
    ReturnCertificate.pairAt (word13 b) i.val =
      ReturnCertificate.pairAt initialThree i.val := by
  cases b <;> fin_cases i <;> rfl

theorem word14_pairAt_first (b : Bool) (i : Fin 3) :
    ReturnCertificate.pairAt (word14 b) i.val =
      ReturnCertificate.pairAt initialThree i.val := by
  cases b <;> fin_cases i <;> rfl

theorem word13_pairAt_center (b : Bool) (n : Fin 13) :
    ReturnCertificate.pairAt (word13 b) (3 + n.val) =
      (F7Periodic.retained (F7Periodic.modeState b n.val)
        (F7Periodic.color n.val) (F7Periodic.modeChoice b n.val),
       (F7Periodic.modeState b n.val).idle) := by
  cases b <;> fin_cases n <;> rfl

theorem word14_pairAt_center (b : Bool) (n : Fin 14) :
    ReturnCertificate.pairAt (word14 b) (3 + n.val) =
      (F7Periodic.retained (F7Periodic.modeState b n.val)
        (F7Periodic.color n.val) (F7Periodic.modeChoice b n.val),
       (F7Periodic.modeState b n.val).idle) := by
  cases b <;> fin_cases n <;> rfl

/-- Support-level receipts are the interface consumed by `RawCut.mode_prefix`;
they deliberately forget pair orientation. -/
theorem word13_support_first (b : Bool) (i : Fin 3) :
    swapSupport (ReturnCertificate.pairAt (word13 b) i.val) =
      swapSupport (ReturnCertificate.pairAt initialThree i.val) := by
  exact congrArg swapSupport (word13_pairAt_first b i)

theorem word14_support_first (b : Bool) (i : Fin 3) :
    swapSupport (ReturnCertificate.pairAt (word14 b) i.val) =
      swapSupport (ReturnCertificate.pairAt initialThree i.val) := by
  exact congrArg swapSupport (word14_pairAt_first b i)

theorem word13_support_center (b : Bool) (n : Fin 13) :
    swapSupport (ReturnCertificate.pairAt (word13 b) (3 + n.val)) =
      {F7Periodic.retained (F7Periodic.modeState b n.val)
        (F7Periodic.color n.val) (F7Periodic.modeChoice b n.val),
       (F7Periodic.modeState b n.val).idle} := by
  simpa [swapSupport] using! congrArg swapSupport (word13_pairAt_center b n)

theorem word14_support_center (b : Bool) (n : Fin 14) :
    swapSupport (ReturnCertificate.pairAt (word14 b) (3 + n.val)) =
      {F7Periodic.retained (F7Periodic.modeState b n.val)
        (F7Periodic.color n.val) (F7Periodic.modeChoice b n.val),
       (F7Periodic.modeState b n.val).idle} := by
  simpa [swapSupport] using! congrArg swapSupport (word14_pairAt_center b n)

/-- Frozen cut relations used by the short-future theorems. -/
def fresh13 (b : Bool) : Rel := graphRel (prefixFresh (word13 b))
def fresh14 (b : Bool) : Rel := graphRel (prefixFresh (word14 b))

def fresh13A : Rel := fresh13 true
def fresh13B : Rel := fresh13 false
def fresh14A : Rel := fresh14 true
def fresh14B : Rel := fresh14 false


end F7Manuscript.G1ShortWords
