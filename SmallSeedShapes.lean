   {(0,3),(1,2),(1,4)},
   {(0,2),(1,3),(1,4)},
   {(0,1),(0,4),(2,3)},
   {(0,4),(1,3),(2,3)},
   {(0,3),(1,4),(2,3)},
   {(0,4),(1,4),(2,3)},
   {(0,1),(0,3),(2,4)},
   {(0,3),(1,3),(2,4)},
   {(0,4),(1,3),(2,4)},
   {(0,3),(1,4),(2,4)},
   {(0,1),(2,3),(2,4)},
   {(0,1),(0,2),(3,4)},
   {(0,2),(1,2),(3,4)},
   {(0,4),(1,2),(3,4)},
   {(0,2),(1,4),(3,4)},
   {(0,1),(2,4),(3,4)}}
def twoSeeds : Finset (Edges 5) :=
  {{(0,4),(1,2),(1,3),(2,3)},
   {(0,2),(0,3),(1,4),(2,3)},
