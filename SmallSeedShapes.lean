   {(0,1),(2,3),(2,4),(3,4)}}
def sixSeeds : Finset (Edges 6) :=
  {{(0,4),(1,2),(1,3),(1,5),(2,3),(2,5),(3,5)},
   {(0,4),(0,5),(1,2),(1,3),(1,5),(2,3),(4,5)},
   {(0,2),(0,3),(0,5),(1,4),(2,3),(2,5),(3,5)},
