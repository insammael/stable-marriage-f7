module

public import N4WholePrefixMemory
public import N4DoubleD0PrefixLiteral

@[expose] public section

/-! First kernel transcription of the frozen HAND Appendix G 2.3/H 1
eight-event prefix. Only the exact two paired rows are inspected; there is
no search, continuation enumeration, length bound or target cost premise. -/
set_option autoImplicit false

namespace F7Manuscript.N4DoubleD0PrefixRectangle
open F7Local F7Paired N4WholePrefixMemory F7Manuscript.N4DoubleD0PrefixLiteral

def pool : Finset F7Paired.Agent := {2,3,4,5}

macro "d0_norm" : tactic => `(tactic|
  norm_num [doubleD0Plan, pool, wholePrefixPast, Finset.range_add_one,
    lastPair, atPrefix, sourcePrefix, initialWord, routePrefix,
    initialSupport, leftCoord, rightCoord, pairedPairs, afterPaired,
    select, other, put, tokensAfter, tokenSwap, Fin.ofNat] at * <;> simp_all)

def handCurrent (firstCross : Bool) (a : F7Paired.Agent) : F7Paired.Token :=
  if a = 0 then 6 else if a = 1 then 0 else if a = 2 then (if firstCross then 5 else 4)
  else if a = 3 then (if firstCross then 4 else 5)
  else if a = 4 then (if firstCross then 3 else 2)
  else if a = 5 then (if firstCross then 2 else 3) else 1

def handPast (a : F7Paired.Agent) : Finset F7Paired.Token :=
  if a = 0 then {0,1,6} else if a = 1 then {0,1} else
  if a = 6 then {1,6} else {2,3,4,5}

/-- Exact state after the eight literal swaps, summarized one actor at a
 time. The only residual dependence is the first physical cross. -/
theorem current_eight_summary (bits : Nat → Bool) (h2 : bits 2 = false) :
    ∀ a, atPrefix id doubleD0Plan bits 8 a = handCurrent (bits 0) a := by
  intro a
  rw [atPrefix, source_k_is_handWord_take bits h2 8 le_rfl]
  cases h0 : bits 0 <;> cases h1 : bits 1 <;> fin_cases a <;> decide

/-- The source past equals the elementary past generated by the explicit
literal word. The route/template machinery occurs only in the shared prefix
lemma, not once per actor/token cell. -/
theorem past_as_handWord (bits : Nat → Bool) (h2 : bits 2 = false)
    (a : F7Paired.Agent) :
    wholePrefixPast id doubleD0Plan bits 8 a =
      (Finset.range 9).image
        (fun j => tokensAfter id ((handWord (bits 0) (bits 1)).take j) a) := by
  unfold wholePrefixPast
  apply Finset.image_congr
  intro j hj
  have hj8 : j ≤ 8 := by have h := Finset.mem_range.mp hj; omega
  simp only [atPrefix]
  rw [source_k_is_handWord_take bits h2 j hj8]

/-- Exact complete past after the eight literal swaps, summarized one
actor at a time. This records both intermediate swaps of each paired move. -/
theorem past_eight_summary (bits : Nat → Bool) (h2 : bits 2 = false) :
    ∀ a, wholePrefixPast id doubleD0Plan bits 8 a = handPast a := by
  intro a
  rw [past_as_handWord bits h2 a]
  cases h0 : bits 0 <;> cases h1 : bits 1 <;> fin_cases a <;> decide

/-- The second cross choice returns the chosen actor's initial token.
The first cross and first label remain arbitrary. -/
theorem second_cross_false (bits : Nat → Bool)
    (H : NoReturn id doubleD0Plan bits) : bits 2 = false := by
  cases hb : bits 2 with
  | false => rfl
  | true =>
    exfalso
    have hm : (if bits 1 then (3 : F7Paired.Agent) else 2) ∈
        ({(lastPair doubleD0Plan bits 6).1,
          (lastPair doubleD0Plan bits 6).2} : Finset F7Paired.Agent) := by
      cases h0 : bits 0 <;> cases h1 : bits 1 <;> d0_norm
    have hf := H.fresh 6 (by decide)
      (if bits 1 then (3 : F7Paired.Agent) else 2) hm 0 (by omega)
    cases h0 : bits 0 <;> cases h1 : bits 1 <;> d0_norm

theorem current_mem_pool (bits : Nat → Bool) (h2 : bits 2 = false) :
    ∀ a ∈ pool, atPrefix id doubleD0Plan bits 8 a ∈ pool := by
  intro a ha
  rw [current_eight_summary bits h2 a]
  cases h0 : bits 0 <;> cases h1 : bits 1 <;> fin_cases a <;>
    simp_all [pool, handCurrent, h0, h1]

theorem pool_saturated (bits : Nat → Bool) (h2 : bits 2 = false) :
    ∀ a ∈ pool, ∀ x ∈ pool,
      x ∈ wholePrefixPast id doubleD0Plan bits 8 a := by
  intro a ha x hx
  rw [past_eight_summary bits h2 a]
  fin_cases a <;> fin_cases x <;> simp [pool, handPast] at *

theorem separated_rows (bits : Nat → Bool) (h2 : bits 2 = false) :
    ∀ a ∈ pool, ∀ x ∉ pool,
      x ∉ wholePrefixPast id doubleD0Plan bits 8 a := by
  intro a ha x hx
  rw [past_eight_summary bits h2 a]
  fin_cases a <;> fin_cases x <;> simp [pool, handPast] at *

theorem separated_columns (bits : Nat → Bool) (h2 : bits 2 = false) :
    ∀ a ∉ pool, ∀ x ∈ pool,
      x ∉ wholePrefixPast id doubleD0Plan bits 8 a := by
  intro a ha x hx
  rw [past_eight_summary bits h2 a]
  fin_cases a <;> fin_cases x <;> simp [pool, handPast] at *

theorem pool_card : pool.card = 4 := by decide


end F7Manuscript.N4DoubleD0PrefixRectangle
