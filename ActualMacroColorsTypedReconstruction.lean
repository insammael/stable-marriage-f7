module

public import Mathlib
public import ActualMacroColorsReconstruction

@[expose] public section

namespace F7Manuscript.W7MacroColorTypedReconstruction

open F7Manuscript.W7MacroColorReconstruction

/-- A normalized color list satisfying the pivot recurrence is exactly the
finite list generated by the frozen `colors(m,pivs)` recurrence. -/
theorem macroColors_eq_of_recurrence
    (pivs : Finset Nat) (m : Nat) (xs : List Nat)
    (hlen : xs.length = m)
    (h0 : xs[0]! = 0) (h1 : xs[1]! = 1)
    (hrec : ∀ k, k + 2 < m →
      xs[k + 2]! = if k + 1 ∈ pivs then xs[k]! else
        3 - xs[k]! - xs[k + 1]!) :
    xs = macroColors pivs m := by
  have hpoint : ∀ i, i < m → xs[i]! = macroColorAt pivs i := by
    intro i
    induction i using Nat.strong_induction_on with
    | h i ih =>
      intro hi
      cases i with
      | zero => simpa using! h0
      | succ i =>
        cases i with
        | zero => simpa using! h1
        | succ k =>
          have hrec' := hrec k (by omega)
          by_cases hp : k + 1 ∈ pivs
          · calc
              xs[k + 2]! = xs[k]! := by simpa [hp] using! hrec'
              _ = macroColorAt pivs k := ih k (by omega) (by omega)
              _ = macroColorAt pivs (k + 2) := by simp [macroColorAt, hp]
          · calc
              xs[k + 2]! = 3 - xs[k]! - xs[k + 1]! := by simpa [hp] using! hrec'
              _ = 3 - macroColorAt pivs k - macroColorAt pivs (k + 1) := by
                rw [ih k (by omega) (by omega), ih (k + 1) (by omega) (by omega)]
              _ = macroColorAt pivs (k + 2) := by simp [macroColorAt, hp]
  apply List.ext_getElem
  · simp [macroColors, hlen]
  · intro i hiX hiG
    have hp := hpoint i (by simpa [hlen] using! hiX)
    simpa only [getElem!_pos xs i hiX, macroColors, List.getElem_ofFn] using! hp


end F7Manuscript.W7MacroColorTypedReconstruction
