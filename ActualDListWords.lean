module

public import ActualDListRecurrenceAndFlags

@[expose] public section

namespace F7Manuscript.W7ActualDListWords

/-- Exact list-valued recursion underlying Python `ds_lists(k,q)`, with the
same feasible first-entry interval. -/
def dsWords : Nat → Nat → List (List Nat)
  | 0, q => if q = 0 then [[]] else []
  | k + 1, q =>
      ((List.range 3).filter fun d =>
        max 0 (q - 2 * k) ≤ d ∧ d ≤ min q 2).flatMap fun d =>
          (dsWords k (q - d)).map (d :: ·)

/-- Every word satisfying the D-list bounds and sum is generated by the exact
recursive range above. This is structural completeness, not a finite census. -/
theorem dlist_mem_dsWords {k q : Nat} {ds : List Nat}
    (h : F7Manuscript.W7ActualDListRecurrenceAndFlags.DListSpec k q ds) :
    ds ∈ dsWords k q := by
  induction k generalizing q ds with
  | zero =>
      rcases h with ⟨hlen, hvals, hsum⟩
      cases ds with
      | nil =>
          have hq : q = 0 := hsum.symm
          simp [dsWords, hq]
      | cons d tail => simp at hlen
  | succ k ih =>
      rcases F7Manuscript.W7ActualDListRecurrenceAndFlags.dlist_recurrence_complete h with
        hbase | ⟨d, tail, hds, hd2, hdq, hupper, htail⟩
      · rcases hbase with ⟨hk, hnil, hq⟩
        omega
      · subst ds
        have hlo : max 0 (q - 2 * k) ≤ d := by omega
        have hhi : d ≤ min q 2 := Nat.le_min.mpr ⟨hdq, hd2⟩
        have hdlt : d < 3 := by omega
        have hdmem : d ∈ ((List.range 3).filter fun x =>
            max 0 (q - 2 * k) ≤ x ∧ x ≤ min q 2) := by
          change d ∈ List.filter (fun x : Nat =>
            max 0 (q - 2 * k) ≤ x ∧ x ≤ min q 2) (List.range 3)
          apply List.mem_filter_of_mem
          · exact List.mem_range.mpr hdlt
          · exact decide_eq_true ⟨hlo, hhi⟩
        apply List.mem_flatMap.mpr
        exact ⟨d, hdmem, List.mem_map.mpr ⟨tail, ih htail, rfl⟩⟩

#print axioms dsWords
#print axioms dlist_mem_dsWords

end F7Manuscript.W7ActualDListWords
