private theorem validNodeOfUsedTwo {m : Nat} (T : Sized.Table m) (j : Fin m)
    (hused : (T j).used = 2)
    (hedges : ∀ e, e ∈ (T j).edges → Sized.ValidEdge T j e)
    (hcover : ∀ a b, Legal (T j).graph 2 (CycleSpec.two a b) →
      ∃ e ∈ (T j).edges, Matches (CycleSpec.two a b) e.cycle) : Sized.ValidNode T j := by
  refine ⟨by omega, hedges, ?_⟩
  intro c hc
  cases c with
  | two a b => exact hcover a b (by simpa [hused] using! hc)
  | three a b d =>
      have hcost := hc.2.1
      rw [hused] at hcost
      norm_num [CycleSpec.cost, CycleSpec.size, CycleSpec.sites] at hcost
  | four a b d e =>
      have hcost := hc.2.1
      rw [hused] at hcost
      norm_num [CycleSpec.cost, CycleSpec.size, CycleSpec.sites] at hcost

