module

public import F7Manuscript.IdealLedger

@[expose] public section

/-!
Appendix A's one fixed event poset. The predecessor-vector order is proved
identical to the order generated by successive participations in the saved
word. Pair counting uses 400 ordered pairs; triple counting first rewrites
to powersetCard 3 (1,140 candidates), so no 2^20-subset census is evaluated.
-/
set_option maxRecDepth 32768
set_option maxHeartbeats 16000000
set_option synthInstance.maxSize 2048

namespace F7Manuscript.Construction
open ConditionalUL NeutralCore

structure Event where
  index : Fin 20
  deriving Fintype, DecidableEq

def group : Fin 20 → Fin 3 := ![0, 1, 2, 1, 0, 2, 1, 2, 0, 2, 1, 0, 2, 1, 0, 2, 0, 1, 2, 0]
def position : Fin 20 → ℕ := ![1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6, 7, 7]
def predecessorVector : Fin 20 → Fin 3 → ℕ := ![
  ![1, 0, 0],
  ![0, 1, 0],
  ![0, 0, 1],
  ![0, 2, 0],
  ![2, 1, 0],
  ![1, 0, 2],
  ![0, 3, 1],
  ![1, 2, 3],
  ![3, 1, 2],
  ![2, 2, 4],
  ![1, 4, 3],
  ![4, 3, 2],
  ![2, 4, 5],
  ![3, 5, 3],
  ![5, 3, 4],
  ![4, 4, 6],
  ![6, 4, 5],
  ![4, 6, 6],
  ![5, 4, 7],
  ![7, 5, 5]]
def parents : Fin 20 → Finset (Fin 20) := ![
  {},
  {},
  {},
  {1},
  {0, 1},
  {0, 2},
  {2, 3},
  {3, 5},
  {4, 5},
  {4, 7},
  {6, 7},
  {6, 8},
  {9, 10},
  {8, 10},
  {9, 11},
  {11, 12},
  {12, 14},
  {13, 15},
  {14, 15},
  {13, 16}]
def word : Fin 20 → Fin 7 × Fin 7 := ![
  (2, 3),
  (0, 1),
  (4, 5),
  (0, 6),
  (1, 2),
  (3, 4),
  (0, 5),
  (3, 6),
  (1, 4),
  (2, 3),
  (0, 6),
  (4, 5),
  (3, 6),
  (0, 1),
  (2, 4),
  (5, 6),
  (2, 3),
  (0, 6),
  (4, 5),
  (1, 2)]

def tableLE (i j : Fin 20) : Prop := position i ≤ predecessorVector j (group i)

instance tableLE_decidable (i j : Fin 20) : Decidable (tableLE i j) :=
  inferInstanceAs (Decidable (position i ≤ predecessorVector j (group i)))

theorem table_refl : ∀ i, tableLE i i := by decide +kernel
theorem table_trans : ∀ i j k, tableLE i j → tableLE j k → tableLE i k := by
  decide +kernel
theorem table_antisymm : ∀ i j, tableLE i j → tableLE j i → i = j := by
  decide +kernel

instance : PartialOrder Event where
  le i j := tableLE i.index j.index
  le_refl i := table_refl i.index
  le_trans i j k := table_trans i.index j.index k.index
  le_antisymm i j hij hji := by
    cases i; cases j
    congr 1
    exact table_antisymm _ _ hij hji

instance : DecidableLE Event := fun i j => tableLE_decidable i.index j.index

def Adj (i j : Event) : Prop := i.index ∈ parents j.index
instance (i j : Event) : Decidable (Adj i j) :=
  inferInstanceAs (Decidable (i.index ∈ parents j.index))

def Participates (i : Fin 20) (m : Fin 7) : Prop :=
  m = (word i).1 ∨ m = (word i).2

instance (i : Fin 20) (m : Fin 7) : Decidable (Participates i m) :=
  inferInstanceAs (Decidable (m = (word i).1 ∨ m = (word i).2))

def SuccessiveParticipation (i j : Fin 20) : Prop :=
  i.val < j.val ∧ ∃ m : Fin 7, Participates i m ∧ Participates j m ∧
    ∀ k : Fin 20, i.val < k.val → k.val < j.val → ¬ Participates k m

instance (i j : Fin 20) : Decidable (SuccessiveParticipation i j) := by
  unfold SuccessiveParticipation
  infer_instance

theorem parents_are_successive_participations :
    ∀ i j : Fin 20, i ∈ parents j ↔ SuccessiveParticipation i j := by
  decide +kernel

theorem parent_order_and_chronology :
    ∀ i j : Fin 20, i ∈ parents j → tableLE i j ∧ i.val < j.val := by
  decide +kernel

theorem predecessor_recursion : ∀ i j : Fin 20, tableLE i j → i ≠ j →
    ∃ p : Fin 20, p ∈ parents j ∧ tableLE i p := by
  decide +kernel

theorem order_is_generated_by_participations (i j : Event) :
    i ≤ j ↔ Relation.ReflTransGen Adj i j := by
  constructor
  · intro hij
    have build : ∀ n : ℕ, ∀ j : Event, j.index.val = n →
        ∀ i : Event, i ≤ j → Relation.ReflTransGen Adj i j := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
          intro j hj i hij
          by_cases heq : i = j
          · subst i
            exact Relation.ReflTransGen.refl
          · have hidx : i.index ≠ j.index := by
              intro h
              apply heq
              cases i; cases j
              congr 1
            obtain ⟨p, hpj, hip⟩ := predecessor_recursion i.index j.index hij hidx
            let previous : Event := ⟨p⟩
            have hp := (parent_order_and_chronology p j.index hpj).2
            have hpath := ih p.val (by omega) previous rfl i hip
            exact hpath.tail hpj
    exact build j.index.val j rfl i hij
  · intro h
    induction h with
    | refl => exact le_rfl
    | @tail j k hpath hstep ih =>
        exact ih.trans (parent_order_and_chronology j.index k.index hstep).1

theorem same_group_comparable : ∀ i j : Fin 20, group i = group j →
    tableLE i j ∨ tableLE j i := by decide +kernel

theorem four_distinct_colors_impossible : ∀ a b c d : Fin 3,
    a ≠ b → a ≠ c → a ≠ d → b ≠ c → b ≠ d → c ≠ d → False := by
  decide +kernel

theorem incomparable_group_distinct {i j : Event} (h : Inc i j) :
    group i.index ≠ group j.index := by
  intro he
  exact (same_group_comparable i.index j.index he).elim h.1 h.2

theorem width_three : NoFourAntichain (V := Event) := by
  intro a b c d hab hac had hbc hbd hcd
  exact four_distinct_colors_impossible _ _ _ _
    (incomparable_group_distinct hab) (incomparable_group_distinct hac)
    (incomparable_group_distinct had) (incomparable_group_distinct hbc)
    (incomparable_group_distinct hbd) (incomparable_group_distinct hcd)

theorem event_card : Fintype.card Event = 20 := by decide +kernel

theorem pair_count : A2 (V := Event) = 46 := by decide +kernel

theorem triples_as_size_three_subsets (P : Finset Event) :
    triples P = (P.powersetCard 3).filter (fun T : Finset Event => AntichainOn (T : Set Event)) := by
  ext T
  simp only [triples, Finset.mem_filter, Finset.mem_powerset, Finset.mem_powersetCard]
  tauto

theorem triple_count : A3 (V := Event) = 18 := by
  change (triples (Finset.univ : Finset Event)).card = 18
  rw [triples_as_size_three_subsets]
  decide +kernel

theorem event_poset_has_85_ideals :
    (IdealCounting.idealSets (V := Event)).card = 85 := by
  rw [IdealCounting.ideal_count_width_three width_three, event_card, pair_count, triple_count]

#print axioms order_is_generated_by_participations
#print axioms parents_are_successive_participations
#print axioms pair_count
#print axioms triple_count
#print axioms event_poset_has_85_ideals
end F7Manuscript.Construction
