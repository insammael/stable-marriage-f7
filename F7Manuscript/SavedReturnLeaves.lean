theorem savedLeaves_count : savedLeaves.length = 38 := by rfl

theorem savedLeaves_valid : List.Forall Valid savedLeaves := by decide

theorem saved_leaf_valid (L : ReturnLeaf) (hL : L ∈ savedLeaves) : Valid L :=
  List.forall_iff_forall_mem.mp savedLeaves_valid L hL

theorem saved_leaf_excludes_actual {q : ℕ} (L : ReturnLeaf) (hL : L ∈ savedLeaves)
    (I : Profile 7) (R : ActualTrajectory.Run I q) :
    ¬ Realizes R.toTokenRun L.word :=
  valid_excludes_actual L (saved_leaf_valid L hL) I R

/-- A missing exchange cannot serve as a return witness. -/
theorem reject_empty_word :
    ¬ Valid { (savedLeaves[0]'(by decide)) with word := [] } := by decide

/-- The initial exchange does not return its moving participant. -/
theorem reject_wrong_return_event :
    ¬ Valid { (savedLeaves[0]'(by decide)) with event := 0 } := by decide

#print axioms savedLeaves_valid
#print axioms saved_leaf_excludes_actual
#print axioms reject_empty_word
#print axioms reject_wrong_return_event

