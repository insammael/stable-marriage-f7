def prefixFresh (word : List (Site × Site)) : Graph := fun a b =>
  decide (∀ t : Fin (word.length + 1),
    ReturnCertificate.origins word t.val a ≠ ReturnCertificate.origins word word.length b)

structure Root where
  «prefix» : List (Site × Site)
  graph : Graph
  closure : Graph
  target : Fin 35
  rename : Reindex

def ValidRoot (r : Root) : Prop :=
  r.rename.Valid ∧ Closure (prefixFresh r.prefix) r.closure ∧
  (∀ a b, r.graph a b = cut (prefixFresh r.prefix) r.closure a b) ∧
  (∀ a b, (table r.target).graph (r.rename.toFun a) (r.rename.toFun b) = r.graph a b) ∧
  (table r.target).used = 0 ∧ (table r.target).budget = 4

instance (r : Root) : Decidable (ValidRoot r) := by unfold ValidRoot; infer_instance

