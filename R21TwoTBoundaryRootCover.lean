def witness (p : Fin 6) (c : Fin 3) (bits : Fin 32) : Fin 48 × Bool :=
 witnesses.getD ((p.val*3+c.val)*32+bits.val) (0,false)

/-- Simultaneous row and token relabeling of the whole common board. -/
def Related (e : Site → Site) (B A : Board) (d da : Site) : Prop :=
 e d=da ∧ ∀ a, e (B.now a)=A.now (e a) ∧ ∀ t, (t∈B.unseen a ↔ e t∈A.unseen (e a))
instance (e : Site → Site) (B A : Board) (d da : Site) : Decidable (Related e B A d da) := by
 unfold Related; infer_instance

def RootChecked (p : Fin 6) (c : Fin 3) (bits : Fin 32) : Prop :=
 let w:=rootWord p c bits
 let wit:=witness p c bits
 freshWord initial w=false ∨
 Related (seedMap wit.1) (replay initial w) (if wit.2 then boardB else boardA)
  (rootIdle p c bits) (if wit.2 then 2 else 1)
instance (p : Fin 6) (c : Fin 3) (bits : Fin 32) : Decidable (RootChecked p c bits) := by
 unfold RootChecked; infer_instance

theorem root_checked_0 : ∀ (c : Fin 3) (bits : Fin 32), RootChecked 0 c bits := by decide

theorem root_checked_1 : ∀ (c : Fin 3) (bits : Fin 32), RootChecked 1 c bits := by decide

theorem root_checked_2 : ∀ (c : Fin 3) (bits : Fin 32), RootChecked 2 c bits := by decide

theorem root_checked_3 : ∀ (c : Fin 3) (bits : Fin 32), RootChecked 3 c bits := by decide

theorem root_checked_4 : ∀ (c : Fin 3) (bits : Fin 32), RootChecked 4 c bits := by decide

theorem root_checked_5 : ∀ (c : Fin 3) (bits : Fin 32), RootChecked 5 c bits := by decide

theorem root_checked (p : Fin 6) (c : Fin 3) (bits : Fin 32) : RootChecked p c bits := by
 fin_cases p
 · exact root_checked_0 c bits
 · exact root_checked_1 c bits
 · exact root_checked_2 c bits
 · exact root_checked_3 c bits
 · exact root_checked_4 c bits
 · exact root_checked_5 c bits

/-- Covers all 6 phases, all 3 initial last-colors, and all 32 five-bit
control assignments. This is a small-root classification, not a search of
complete 21-event executions. Physical extraction of a root remains separate. -/
theorem canonical_root_representative (p : Fin 6) (c : Fin 3) (bits : Fin 32)
 (hf : freshWord initial (rootWord p c bits)=true) :
 ∃ e : Equiv.Perm Site,
  Related e (replay initial (rootWord p c bits)) boardA (rootIdle p c bits) 1 ∨
  Related e (replay initial (rootWord p c bits)) boardB (rootIdle p c bits) 2 := by
 have h:=root_checked p c bits
 change freshWord initial (rootWord p c bits)=false ∨ _ at h
 rcases h with h|h
 · rw [hf] at h; contradiction
 · refine ⟨seedEquiv (witness p c bits).1,?_⟩
   change Related (seedMap (witness p c bits).1) _ _ _ _ at h
   cases hb : (witness p c bits).2
   · exact Or.inl (by simpa only [hb, Bool.false_eq_true, ↓reduceIte] using! h)
   · exact Or.inr (by simpa only [hb, ↓reduceIte] using! h)

#print axioms canonical_root_representative
end F7Manuscript.TripleCoordinateLattice.R21TwoTBoundaryFinite
