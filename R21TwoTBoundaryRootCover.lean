def seedMap (i : Fin 48) (a : Site) : Site := ((seedPermRows.getD i.val []).getD a.val 0)
theorem seedMap_bijective (i : Fin 48) : Function.Bijective (seedMap i) := by
  fin_cases i <;> decide
noncomputable def seedEquiv (i : Fin 48) : Equiv.Perm Site := Equiv.ofBijective (seedMap i) (seedMap_bijective i)

