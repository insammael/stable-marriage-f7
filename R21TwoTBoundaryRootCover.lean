set_option maxRecDepth 32768
set_option maxHeartbeats 16000000

def freshWord : Board → List Swap → Bool
 | _, [] => true
 | B, e::es => fresh B e && freshWord (step B e) es

def bitCode (n k : Nat) : Bool := n.testBit k

def rootWord (p : Fin 6) (c : Fin 3) (bits : Fin 32) : List Swap :=
 cutWord (shortChart 5 p 0) (canonicalFrame c) (bitCode bits.val)
def rootIdle (p : Fin 6) (c : Fin 3) (bits : Fin 32) : Site :=
 (supportsRouteFinal (canonicalFrame c) (chartPlan (shortChart 5 p 0)) (bitCode bits.val) 0).idle

