module

public import Mathlib
public import ActualNormalizedColorUniquenessContract

@[expose] public section

namespace F7Manuscript.W7MacroColorReconstruction

open F7Manuscript.W7ActualSelectorComposition

/-- The pointwise form of the frozen Python `colors(m,pivs)` recurrence. -/
def macroColorAt (pivs : Finset Nat) : Nat → Nat
  | 0 => 0
  | 1 => 1
  | n + 2 => if n + 1 ∈ pivs then macroColorAt pivs n
      else 3 - macroColorAt pivs n - macroColorAt pivs (n + 1)

/-- A finite color word generated by the macro recurrence. -/
def macroColors (pivs : Finset Nat) (m : Nat) : List Nat :=
  List.ofFn (fun i : Fin m => macroColorAt pivs i.val)

private theorem thirdColorFacts {a b : Nat} (ha : a < 3) (hb : b < 3)
    (hab : a ≠ b) :
    3 - a - b < 3 ∧ 3 - a - b ≠ a ∧ 3 - a - b ≠ b := by
  interval_cases a <;> interval_cases b <;> omega

theorem macroColorAt_facts (pivs : Finset Nat) :
    ∀ n, macroColorAt pivs n < 3 ∧
      macroColorAt pivs n ≠ macroColorAt pivs (n + 1) := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    cases n with
    | zero => simp [macroColorAt]
    | succ n =>
      cases n with
      | zero =>
        simp only [macroColorAt]
        split <;> norm_num
      | succ k =>
        have hk := ih k (by omega)
        have hk1 := ih (k + 1) (by omega)
        have hN : macroColorAt pivs (k + 2) < 3 := by
          by_cases h1 : k + 1 ∈ pivs
          · simpa [macroColorAt, h1] using hk.1
          · simpa [macroColorAt, h1] using
              (thirdColorFacts hk.1 hk1.1 hk.2).1
        have hNadj : macroColorAt pivs (k + 2) ≠
            macroColorAt pivs (k + 3) := by
          by_cases h2 : k + 2 ∈ pivs
          · simpa [macroColorAt, h2] using hk1.2.symm
          · have hnext := thirdColorFacts hk1.1 hN hk1.2
            simpa [macroColorAt, h2] using hnext.2.2.symm
        exact ⟨hN, hNadj⟩

theorem macroColorAt_lt_three (pivs : Finset Nat) (n : Nat) :
    macroColorAt pivs n < 3 := (macroColorAt_facts pivs n).1

theorem macroColorAt_adjacent_ne (pivs : Finset Nat) (n : Nat) :
    macroColorAt pivs n ≠ macroColorAt pivs (n + 1) :=
  (macroColorAt_facts pivs n).2

theorem macroColorAt_aba_iff (pivs : Finset Nat) (n : Nat) :
    (macroColorAt pivs n = macroColorAt pivs (n + 2)) ↔ n + 1 ∈ pivs := by
  by_cases h : n + 1 ∈ pivs
  · simpa [macroColorAt, h]
  · have hthird := thirdColorFacts
      (macroColorAt_lt_three pivs n)
      (macroColorAt_lt_three pivs (n + 1))
      (macroColorAt_adjacent_ne pivs n)
    constructor
    · intro heq
      exact False.elim (hthird.2.1 (by simpa [macroColorAt, h] using heq.symm))
    · intro hpiv
      exact False.elim (h hpiv)

theorem macroColors_reconstruct_from_aba
    (pivs : Finset Nat) (m : Nat) (hm : 2 ≤ m) :
    macroColors pivs m =
      List.ofFn (fun i : Fin m => macroColorAt pivs i.val) := rfl


end F7Manuscript.W7MacroColorReconstruction
