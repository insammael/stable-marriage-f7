def reasonValid (b : Board) (side : Bool) (edge : Nat × Nat) : Reason → Bool
  | .next n => match table[n]? with
    | none => false
    | some node => extend b side edge == node.board
  | .repeat cell => (arrivals b side edge).contains cell && !b.holes.contains cell
  | .short word bound =>
    contains (marks (extend b side edge)) word && decide (fee word < bound) &&
    [(4,1),(5,2),(6,3),(8,4),(10,5)].contains (word.length,bound)
  | .forbidden word =>
    let fs := [[false,false,false,true,true,true],
      [false,true,true,false,true,false,false],
      [false,true,true,false,false,true,false],
      [false,true,false,true,false,true,false,true]]
    contains (marks (extend b side edge)) word &&
      (fs.contains word || fs.contains word.reverse)
def nodeValid (n : Node) : Bool :=
  if n.terminal then n.branches.isEmpty && n.closeTo.isNone
  else
    let e := endpoint n.board n.side
    !e.shut &&
    (choices e).all (fun edge => (n.branches.map Prod.fst).contains edge) &&
    n.branches.all (fun p => (choices e).contains p.1 && reasonValid n.board n.side p.1 p.2) &&
    match n.closeTo with
    | none => (endpoint n.board (!n.side)).shut
    | some j => !(endpoint n.board (!n.side)).shut &&
      match table[j]? with
      | none => false
      | some next => close n.board n.side == next.board

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 32768 in
theorem checked_all : table.all nodeValid = true := by decide +kernel

/-- Every one of the four next physical supports is listed at each nonterminal
fixed board. This is a coverage theorem for table branches, independent of
any choice of representative bits. The physical reduction to one of the four
root frames is a separate obligation. -/
theorem all_next_supports_listed (n : Node) (member : n ∈ table)
    (notTerminal : n.terminal = false) (edge : Nat × Nat)
    (allowed : edge ∈ choices (endpoint n.board n.side)) :
    edge ∈ n.branches.map Prod.fst := by
  have valid := List.all_eq_true.mp checked_all n member
  simp only [nodeValid,notTerminal,Bool.false_eq_true,↓reduceIte] at valid
  have covered := (Bool.and_eq_true_iff.mp
    (Bool.and_eq_true_iff.mp (Bool.and_eq_true_iff.mp valid).1).1).2
  exact List.contains_iff_mem.mp (List.all_eq_true.mp covered edge allowed)

def successors (n : Node) : List Nat :=
  n.closeTo.toList ++ n.branches.filterMap (fun p => match p.2 with
    | .next i => some i
    | _ => none)

theorem checked_increasing :
    table.zipIdx.all (fun p => (successors p.1).all (fun j => decide (p.2 < j))) = true := by
  decide +kernel

/-- Every table edge increases its index, including a declared physical end.
The finite table therefore admits backward induction without cycles. -/
theorem successor_index_increases {i : Nat} {n : Node}
    (atIndex : table[i]? = some n) {j : Nat} (next : j ∈ successors n) : i < j := by
  have member : (n,i) ∈ table.zipIdx := List.mk_mem_zipIdx_iff_getElem?.mpr atIndex
  have row := List.all_eq_true.mp checked_increasing (n,i) member
  exact of_decide_eq_true (List.all_eq_true.mp row j next)

end F7Manuscript.R21LongWindow.DatedPureTable
