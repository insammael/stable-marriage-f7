structure End where
  perm : List Nat
  frame : List (Nat × Nat)
  idle : Nat
  last : Nat
  shut : Bool
  deriving DecidableEq, Repr
structure Board where
  left : End
  right : End
  holes : List Nat
  colors : List Nat
  deriving DecidableEq, Repr
def ordered (a b : Nat) := (min a b, max a b)
def choices (e : End) : List (Nat × Nat) :=
  (List.range 3).filter (fun c => c != e.last) |>.flatMap fun c =>
    let p := e.frame.getD c (0,0)
    [ordered e.idle p.1, ordered e.idle p.2]
def endpoint (b : Board) (side : Bool) := if side then b.right else b.left
def putEnd (b : Board) (side : Bool) (e : End) :=
  if side then {b with right := e} else {b with left := e}
def close (b : Board) (side : Bool) : Board :=
  putEnd b side {endpoint b side with shut := true}
def colorOf (e : End) (a : Nat) : Nat :=
  ((List.range 3).filter fun c => let p := e.frame.getD c (0,0); a=p.1 || a=p.2).headD 3
def arrivals (b : Board) (side : Bool) (edge : Nat × Nat) : List Nat :=
  let p := (endpoint b side).perm
  [7*edge.1+p.getD edge.2 0, 7*edge.2+p.getD edge.1 0]
def extend (b : Board) (side : Bool) (edge : Nat × Nat) : Board :=
  let e := endpoint b side
  let a := if edge.1 = e.idle then edge.2 else edge.1
  let c := colorOf e a
  let pair := e.frame.getD c (0,0)
  let newIdle := if pair.1 = a then pair.2 else pair.1
  let p := (List.range 7).map fun i =>
    if i=edge.1 then e.perm.getD edge.2 0
    else if i=edge.2 then e.perm.getD edge.1 0 else e.perm.getD i 0
  let e' : End := ⟨p,e.frame.set c (a,e.idle),newIdle,c,e.shut⟩
  let next := putEnd b side e'
  {next with holes := b.holes.filter (fun cell => !(arrivals b side edge).contains cell)
             colors := if side then b.colors++[c] else c::b.colors}
def marks (b : Board) : List Bool :=
  (b.colors.zip (b.colors.drop 2)).map fun p => p.1 == p.2
def contains (w pattern : List Bool) : Bool :=
  (List.range (w.length+1)).any fun i => (w.drop i).take pattern.length == pattern
def fee (w : List Bool) := (w.filter id).length
inductive Reason where
  | next (n : Nat)
  | repeat (cell : Nat)
  | short (word : List Bool) (bound : Nat)
  | forbidden (word : List Bool)
  deriving DecidableEq, Repr
structure Node where
  board : Board
  side : Bool
  terminal : Bool
  closeTo : Option Nat
  branches : List ((Nat × Nat) × Reason)
  deriving DecidableEq, Repr

